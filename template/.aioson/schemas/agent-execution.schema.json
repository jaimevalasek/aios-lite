{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aioson.dev/schemas/agent-execution-v2.json",
  "title": "AIOSON Agent Execution Manifest",
  "type": "object",
  "required": ["version", "feature", "host", "agents", "capacity_policy", "cycle_limits", "reporting"],
  "properties": {
    "version": { "enum": [1, 2] },
    "feature": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "host": { "$ref": "#/$defs/host" },
    "generated_at": { "type": "string" },
    "agents": {
      "type": "object",
      "required": ["dev", "qa", "tester", "pentester", "validator"],
      "additionalProperties": false,
      "properties": {
        "dev": { "$ref": "#/$defs/agent" },
        "qa": { "$ref": "#/$defs/agent" },
        "tester": { "$ref": "#/$defs/agent" },
        "pentester": { "$ref": "#/$defs/agent" },
        "validator": { "$ref": "#/$defs/agent" }
      }
    },
    "development_lanes": {
      "type": "object",
      "required": ["strategy", "integration_owner", "lanes"],
      "additionalProperties": false,
      "properties": {
        "strategy": { "enum": ["single", "split"] },
        "integration_owner": { "const": "dev" },
        "lanes": {
          "type": "object",
          "maxProperties": 8,
          "propertyNames": { "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "additionalProperties": { "$ref": "#/$defs/developmentLane" }
        }
      }
    },
    "capacity_policy": {
      "type": "object",
      "required": ["strategy", "max_attempts", "backoff_ms"],
      "additionalProperties": false,
      "properties": {
        "strategy": { "enum": ["pause", "retry", "wait", "fallback"] },
        "max_attempts": { "type": "integer", "minimum": 1 },
        "backoff_ms": { "type": "integer", "minimum": 0 },
        "allow_cross_host": { "type": "boolean" }
      }
    },
    "cycle_limits": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "orchestration": {
      "type": "object",
      "required": ["mode", "max_checkpoints", "stop_conditions"],
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["inherit", "autopilot", "step_by_step"] },
        "execution": { "enum": ["single", "orchestrated"] },
        "max_checkpoints": { "type": "integer", "minimum": 1, "maximum": 50 },
        "stop_conditions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
        }
      }
    },
    "chain_work_policy": {
      "type": "object",
      "required": ["enabled", "fallback_owner", "require_enabled_owner", "qa_revalidation", "block_handoff_on_actionable", "owner_by_kind"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "fallback_owner": { "$ref": "#/$defs/chainOwner" },
        "require_enabled_owner": { "type": "boolean" },
        "qa_revalidation": { "type": "boolean" },
        "block_handoff_on_actionable": { "type": "boolean" },
        "owner_by_kind": {
          "type": "object",
          "required": ["inspect", "fix", "test", "security", "documentation"],
          "additionalProperties": false,
          "properties": {
            "inspect": { "$ref": "#/$defs/chainOwner" },
            "fix": { "$ref": "#/$defs/chainOwner" },
            "test": { "$ref": "#/$defs/chainOwner" },
            "security": { "$ref": "#/$defs/chainOwner" },
            "documentation": { "$ref": "#/$defs/chainOwner" }
          }
        }
      }
    },
    "reporting": {
      "type": "object",
      "required": ["format", "markdown"],
      "additionalProperties": false,
      "properties": {
        "format": { "type": "string" },
        "markdown": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "host": { "enum": ["claude", "codex", "opencode", "kimi", "qwen"] },
    "chainOwner": { "enum": ["dev", "tester", "pentester"] },
    "fallback": {
      "type": "object",
      "required": ["host", "model"],
      "additionalProperties": false,
      "properties": {
        "host": { "$ref": "#/$defs/host" },
        "model": { "type": "string", "minLength": 1, "maxLength": 200 },
        "on": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["capacity", "unavailable"] }
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "host", "mode", "model", "writable_roots", "fallbacks", "report"],
      "properties": {
        "enabled": { "type": "boolean" },
        "host": { "$ref": "#/$defs/host" },
        "mode": { "enum": ["fresh-session", "subagent", "external", "current-session"] },
        "model": { "type": "string", "minLength": 1, "maxLength": 200 },
        "reasoning_effort": { "enum": ["low", "medium", "high", "xhigh", "max", "ultra"] },
        "writable_roots": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "fallbacks": { "type": "array", "items": { "$ref": "#/$defs/fallback" } },
        "report": { "type": "string", "pattern": "\\{run_id\\}" }
      }
    },
    "developmentLane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "host", "mode", "model", "writable_roots", "prompt", "write_paths", "fallbacks", "report"],
      "properties": {
        "enabled": { "type": "boolean" },
        "host": { "$ref": "#/$defs/host" },
        "mode": { "enum": ["fresh-session", "subagent", "external", "current-session"] },
        "model": { "type": "string", "minLength": 1, "maxLength": 200 },
        "reasoning_effort": { "enum": ["low", "medium", "high", "xhigh", "max", "ultra"] },
        "writable_roots": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "prompt": { "type": "string", "minLength": 1 },
        "write_paths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "fallbacks": { "type": "array", "items": { "$ref": "#/$defs/fallback" } },
        "report": { "type": "string", "pattern": "\\{run_id\\}" },
        "qa": { "$ref": "#/$defs/laneQa" }
      }
    },
    "laneQa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "model", "report"],
      "properties": {
        "host": { "$ref": "#/$defs/host" },
        "model": { "type": "string", "minLength": 1, "maxLength": 200 },
        "reasoning_effort": { "enum": ["low", "medium", "high", "xhigh", "max", "ultra"] },
        "report": { "type": "string", "pattern": "\\{run_id\\}" },
        "fallbacks": { "type": "array", "items": { "$ref": "#/$defs/fallback" } },
        "max_fix_files": { "type": "integer", "minimum": 0, "maximum": 20 },
        "max_rework_rounds": { "type": "integer", "minimum": 0, "maximum": 3 }
      }
    }
  },
  "additionalProperties": false
}
